{
  "openapi": "3.1.0",
  "info": {
    "title": "NeuroScope",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/network": {
      "get": {
        "summary": "Network",
        "operationId": "network_api_network_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Network"
                }
              }
            }
          }
        }
      }
    },
    "/api/presentation": {
      "get": {
        "summary": "Current presentation",
        "responses": {
          "200": {
            "description": "Current snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Presentation"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update editor view using its current revision",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditorUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Presentation"
                }
              }
            }
          },
          "400": {
            "description": "Invalid editor state or neuron index"
          },
          "409": {
            "description": "State or layer was changed by another client",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Presentation"
                }
              }
            }
          }
        }
      }
    },
    "/api/presentation/pins": {
      "post": {
        "summary": "Add or remove neurons from one layer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Presentation"
                }
              }
            }
          },
          "400": {
            "description": "Invalid editor state or neuron index"
          },
          "409": {
            "description": "State or layer was changed by another client",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Presentation"
                }
              }
            }
          }
        }
      }
    },
    "/api/presentation/events": {
      "get": {
        "summary": "Stream the latest snapshot and subsequent changes",
        "responses": {
          "200": {
            "description": "Server-sent events with Presentation JSON",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Layer": {
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Id"
          },
          "shape": {
            "$ref": "#/components/schemas/Shape"
          }
        },
        "type": "object",
        "required": [
          "id",
          "shape"
        ],
        "title": "Layer"
      },
      "Network": {
        "properties": {
          "input_shape": {
            "$ref": "#/components/schemas/Shape"
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Conv2D"
            }
          },
          "layers": {
            "items": {
              "$ref": "#/components/schemas/Layer"
            },
            "type": "array",
            "minItems": 1,
            "title": "Layers",
            "readOnly": true,
            "description": "Derived tensor shapes, including the input."
          }
        },
        "type": "object",
        "required": [
          "input_shape",
          "operations",
          "layers"
        ],
        "title": "Network"
      },
      "Shape": {
        "items": {
          "type": "integer",
          "maximum": 30.0,
          "minimum": 1.0
        },
        "type": "array",
        "maxItems": 3,
        "minItems": 1,
        "title": "Shape"
      },
      "SpatialPair": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "description": "Height and width, in that order."
      },
      "Conv2D": {
        "type": "object",
        "required": [
          "type",
          "in_channels",
          "out_channels",
          "kernel_size",
          "stride",
          "padding",
          "dilation",
          "groups"
        ],
        "properties": {
          "type": {
            "const": "Conv2D"
          },
          "in_channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "out_channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "kernel_size": {
            "$ref": "#/components/schemas/SpatialPair"
          },
          "stride": {
            "$ref": "#/components/schemas/SpatialPair"
          },
          "padding": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "dilation": {
            "$ref": "#/components/schemas/SpatialPair"
          },
          "groups": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        }
      },
      "NodeRef": {
        "type": "object",
        "properties": {
          "layer": {
            "type": "integer",
            "minimum": 1
          },
          "index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "layer",
          "index"
        ]
      },
      "EditorUpdate": {
        "type": "object",
        "properties": {
          "editorRevision": {
            "type": "integer",
            "minimum": 0
          },
          "network": {
            "$ref": "#/components/schemas/Network"
          },
          "visible": {
            "type": "integer",
            "minimum": 1
          },
          "selected": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NodeRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "direction": {
            "enum": [
              "self",
              "upstream",
              "downstream"
            ]
          }
        },
        "required": [
          "editorRevision",
          "network",
          "visible",
          "selected",
          "direction"
        ]
      },
      "Presentation": {
        "type": "object",
        "properties": {
          "editorRevision": {
            "type": "integer",
            "minimum": 0
          },
          "network": {
            "$ref": "#/components/schemas/Network"
          },
          "visible": {
            "type": "integer",
            "minimum": 1
          },
          "selected": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NodeRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "direction": {
            "enum": [
              "self",
              "upstream",
              "downstream"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "pins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NodeRef"
            }
          }
        },
        "required": [
          "editorRevision",
          "network",
          "visible",
          "selected",
          "direction",
          "revision",
          "pins"
        ]
      },
      "PinUpdate": {
        "type": "object",
        "properties": {
          "layer": {
            "type": "integer",
            "minimum": 1
          },
          "shape": {
            "$ref": "#/components/schemas/Shape"
          },
          "indices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "required": [
          "layer",
          "shape",
          "indices",
          "pinned"
        ]
      }
    }
  }
}
