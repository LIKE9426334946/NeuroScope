{
  "openapi": "3.1.0",
  "info": {
    "title": "NeuroScope",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/network": {
      "get": {
        "summary": "Network",
        "operationId": "network_api_network_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Network"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Layer": {
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Id"
          },
          "shape": {
            "$ref": "#/components/schemas/Shape"
          }
        },
        "type": "object",
        "required": [
          "id",
          "shape"
        ],
        "title": "Layer"
      },
      "Network": {
        "properties": {
          "input_shape": {
            "$ref": "#/components/schemas/Shape"
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Conv2D"
            }
          },
          "layers": {
            "items": {
              "$ref": "#/components/schemas/Layer"
            },
            "type": "array",
            "minItems": 1,
            "title": "Layers",
            "readOnly": true,
            "description": "Derived tensor shapes, including the input."
          }
        },
        "type": "object",
        "required": [
          "input_shape",
          "operations",
          "layers"
        ],
        "title": "Network"
      },
      "Shape": {
        "items": {
          "type": "integer",
          "maximum": 30.0,
          "minimum": 1.0
        },
        "type": "array",
        "maxItems": 3,
        "minItems": 1,
        "title": "Shape"
      },
      "SpatialPair": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "description": "Height and width, in that order."
      },
      "Conv2D": {
        "type": "object",
        "required": [
          "type",
          "in_channels",
          "out_channels",
          "kernel_size",
          "stride",
          "padding",
          "dilation",
          "groups"
        ],
        "properties": {
          "type": {
            "const": "Conv2D"
          },
          "in_channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "out_channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "kernel_size": {
            "$ref": "#/components/schemas/SpatialPair"
          },
          "stride": {
            "$ref": "#/components/schemas/SpatialPair"
          },
          "padding": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "dilation": {
            "$ref": "#/components/schemas/SpatialPair"
          },
          "groups": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        }
      }
    }
  }
}
